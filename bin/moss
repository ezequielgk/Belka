#!/bin/sh

MOSS_VERSION=1.1.1
PROG_NAME=moss

MOSS_PREFIX=${MOSS_PREFIX:-}
MOSS_STATE_DIR=${MOSS_STATE_DIR:-}
MOSS_CACHE_DIR=${MOSS_CACHE_DIR:-}
MOSS_INDEX_URL=${MOSS_INDEX_URL:-https://raw.githubusercontent.com/ezequielgk/Moss/main/packages.tsv}
MOSS_INDEX_TTL=${MOSS_INDEX_TTL:-24}

MOSS_SYSTEM=${MOSS_SYSTEM:-0}
MOSS_DRY_RUN=0
MOSS_FORCE=0
MOSS_JSON=0
MOSS_ASSUME_YES=0
MOSS_OFFLINE=0
MOSS_SYNC_FORCE=0
MOSS_LOG_LEVEL=2

MOSS_EX_OK=0
MOSS_EX_USAGE=1
MOSS_EX_DOWNLOAD=2
MOSS_EX_VERIFY=3
MOSS_EX_INSTALL=4
MOSS_EX_CONFLICT=5
MOSS_EX_DEP=6

MOSS_TAB=$(printf '\t')

# Imprime mensajes en la consola con diferentes niveles de severidad.
#
# Argumentos:
#   $1 - Nivel de log (INFO, STEP, WARN, ERROR, SUCCESS, DEBUG)
#   $2.. - Mensaje a imprimir
# Globales:
#   MOSS_LOG_LEVEL
# Retorna:
#   0 siempre
moss_log() {
    _moss_l_level=$1
    shift
    case $_moss_l_level in
        INFO)    _moss_l_num=2 _moss_l_tag="==>" ;;
        STEP)    _moss_l_num=2 _moss_l_tag="  ->" ;;
        WARN)    _moss_l_num=1 _moss_l_tag="[ADVERTENCIA]" ;;
        ERROR)   _moss_l_num=0 _moss_l_tag="[ERROR]" ;;
        SUCCESS) _moss_l_num=2 _moss_l_tag="==> EXITO:" ;;
        DEBUG)   _moss_l_num=3 _moss_l_tag="depur" ;;
        *) return 0 ;;
    esac
    [ "$_moss_l_num" -le "$MOSS_LOG_LEVEL" ] || return 0
    printf '%s %s\n' "$_moss_l_tag" "$*" >&2
}

# Termina la ejecucion del programa tras imprimir un mensaje de error.
#
# Argumentos:
#   $1 - Codigo de salida
#   $2.. - Mensaje de error
# Globales:
#   Ninguna
# Retorna:
#   Sale del script con el codigo indicado
moss_die() {
    _moss_d_code=$1
    shift
    moss_log ERROR "$*"
    exit "$_moss_d_code"
}

# Imprime y actualiza una barra de progreso estatica en linea.
#
# Argumentos:
#   $1 - Valor actual
#   $2 - Valor total
#   $3 - Mensaje corto descriptivo
# Globales:
#   Ninguna
# Retorna:
#   0 siempre
moss_progress() {
    _moss_curr=$1
    _moss_tot=$2
    _moss_msg=$3
    
    [ "$_moss_tot" -eq 0 ] && return 0
    
    _moss_pct=$(( (_moss_curr * 100) / _moss_tot ))
    _moss_filled=$(( (_moss_curr * 40) / _moss_tot ))
    _moss_empty=$(( 40 - _moss_filled ))
    
    _moss_bar=""
    _moss_i=0
    while [ "$_moss_i" -lt "$_moss_filled" ]; do
        _moss_bar="${_moss_bar}#"
        _moss_i=$((_moss_i + 1))
    done
    
    _moss_i=0
    while [ "$_moss_i" -lt "$_moss_empty" ]; do
        _moss_bar="${_moss_bar}-"
        _moss_i=$((_moss_i + 1))
    done
    
    printf '\r%-25.25s [%s] %3d%%' "$_moss_msg" "$_moss_bar" "$_moss_pct"
    
    if [ "$_moss_curr" -ge "$_moss_tot" ]; then
        printf '\n'
    fi
}

# Limpia los archivos temporales generados durante la ejecucion.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_TMPDIR
# Retorna:
#   0 siempre
moss_cleanup() {
    if [ -n "${MOSS_TMPDIR:-}" ] && [ -d "$MOSS_TMPDIR" ]; then
        rm -rf "$MOSS_TMPDIR"
    fi
}

# Crea un directorio temporal de manera segura y compatible.
#
# Argumentos:
#   Ninguno
# Globales:
#   TMPDIR
# Retorna:
#   0 si tiene exito, 1 si falla. Imprime la ruta al stdout.
moss_mktempdir() {
    _moss_m_dir=$(mktemp -d "${TMPDIR:-/tmp}/tm.XXXXXX" 2>/dev/null) && {
        printf '%s\n' "$_moss_m_dir"
        return 0
    }
    _moss_m_dir="${TMPDIR:-/tmp}/tm.$$"
    (umask 077 && mkdir "$_moss_m_dir" 2>/dev/null) && {
        printf '%s\n' "$_moss_m_dir"
        return 0
    }
    return 1
}

# Carga la configuracion global del usuario desde XDG_CONFIG_HOME.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_INDEX_URL, MOSS_INDEX_TTL
# Retorna:
#   0 si el archivo existe y es leido, 1 si no.
moss_load_config() {
    _moss_c_file=${MOSS_CONFIG:-$HOME/.config/moss/config}
    [ -f "$_moss_c_file" ] || return 0
    while IFS= read -r _moss_c_line; do
        case $_moss_c_line in
            ''|\#*) continue ;;
        esac
        _moss_c_key=${_moss_c_line%%=*}
        _moss_c_val=${_moss_c_line#*=}
        [ "$_moss_c_key" = "$_moss_c_line" ] && continue
        case $_moss_c_key in
            MOSS_PREFIX)     MOSS_PREFIX=$_moss_c_val ;;
            MOSS_STATE_DIR)  MOSS_STATE_DIR=$_moss_c_val ;;
            MOSS_CACHE_DIR)  MOSS_CACHE_DIR=$_moss_c_val ;;
            MOSS_INDEX_URL)  MOSS_INDEX_URL=$_moss_c_val ;;
            MOSS_INDEX_TTL)  MOSS_INDEX_TTL=$_moss_c_val ;;
        esac
    done < "$_moss_c_file"
}

# Aplica valores por defecto a configuraciones criticas si estan vacias.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_PREFIX, MOSS_STATE_DIR, MOSS_CACHE_DIR, HOME
# Retorna:
#   Ninguno
moss_apply_defaults() {
    [ -z "$MOSS_PREFIX" ]    && MOSS_PREFIX="$HOME/.local/moss"
    [ -z "$MOSS_STATE_DIR" ] && MOSS_STATE_DIR="$HOME/.local/share/moss"
    [ -z "$MOSS_CACHE_DIR" ] && MOSS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/moss"
}

# Reconfigura las rutas globales si se solicita el ambito del sistema.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_SYSTEM, MOSS_PREFIX, MOSS_STATE_DIR
# Retorna:
#   0 siempre
moss_apply_scope() {
    if [ "$MOSS_SYSTEM" -eq 1 ]; then
        MOSS_PREFIX=/usr/local/moss
        MOSS_STATE_DIR=/var/lib/moss
    fi
}

# Inicializa los directorios de estado, cache e indice locales.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_PREFIX, MOSS_STATE_DIR, MOSS_CACHE_DIR
# Retorna:
#   0 si tiene exito creando directorios, exit >0 en error
moss_state_init() {
    moss_apply_scope
    moss_apply_defaults
    mkdir -p "$MOSS_PREFIX" "$MOSS_STATE_DIR" "$MOSS_CACHE_DIR" 2>/dev/null || {
        moss_log ERROR "no se pudo crear $MOSS_PREFIX, $MOSS_STATE_DIR o $MOSS_CACHE_DIR (permisos?)"
        return 1
    }
}

# Calcula el hash SHA256 de un archivo usando shasum, sha256sum u openssl.
#
# Argumentos:
#   $1 - Ruta del archivo
# Globales:
#   Ninguna
# Retorna:
#   0 e imprime el hash si tiene exito, 1 si falla
moss_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        return 1
    fi
}

# Descarga un archivo desde una URL manejando fallback a wget.
#
# Argumentos:
#   $1 - URL de origen
#   $2 - Archivo de destino
# Globales:
#   Ninguna
# Retorna:
#   0 si descarga exitosa, exit 2 si fallan curl y wget
moss_download() {
    case $1 in
        http://*|https://*)
            if command -v curl >/dev/null 2>&1; then
                curl -# -fSL -o "$2" "$1"
            elif command -v wget >/dev/null 2>&1; then
                wget -q --show-progress -O "$2" "$1"
            else
                moss_log ERROR "se necesita curl o wget para descargar $1"
                return $MOSS_EX_DEP
            fi
            ;;
        file://*)
            cp "${1#file://}" "$2"
            ;;
        *)
            cp "$1" "$2"
            ;;
    esac
}

# Compara dos versiones semanticas para determinar cual es mayor.
#
# Argumentos:
#   $1 - Version A
#   $2 - Version B
# Globales:
#   Ninguna
# Retorna:
#   0 si A > B, 1 en caso contrario
moss_version_gt() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        na = split(a, xa, /[^0-9]+/)
        nb = split(b, xb, /[^0-9]+/)
        for (i = 1; i <= na || i <= nb; i++) {
            va = (i <= na) ? xa[i] + 0 : 0
            vb = (i <= nb) ? xb[i] + 0 : 0
            if (va > vb) { print 1; exit }
            if (va < vb) { print 0; exit }
        }
        print 0
    }'
}

# Escapa cadenas de texto para ser incrustadas de forma segura en JSON.
#
# Argumentos:
#   $1 - Cadena de texto
# Globales:
#   Ninguna
# Retorna:
#   0 e imprime el texto escapado en stdout
moss_jesc() {
    printf '%s' "$1" | awk '
    {
        gsub(/\\/, "\\\\")
        gsub(/"/, "\\\"")
        gsub(/\t/, "\\t")
        if (NR > 1) printf "\\n"
        printf "%s", $0
    }'
}

# Devuelve la ruta local cacheada del indice de paquetes.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_CACHE_DIR
# Retorna:
#   Imprime la ruta al stdout
moss_index_cache_file() {
    printf '%s\n' "$MOSS_CACHE_DIR/index/packages.tsv"
}

# Comprueba si la fuente del indice es una URL de red valida (http/https).
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_INDEX_URL
# Retorna:
#   0 si es red, 1 si es archivo local
moss_index_source_is_url() {
    case ${MOSS_INDEX_URL:-} in
        http://*|https://*|file://*) return 0 ;;
        *) return 1 ;;
    esac
}

# Evalua si el indice cacheado es fresco basandose en el TTL configurado.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_INDEX_TTL
# Retorna:
#   0 si esta fresco, 1 si requiere renovacion
moss_index_fresh() {
    _moss_f_file=$1
    [ -f "$_moss_f_file" ] || return 1
    case ${MOSS_INDEX_TTL:-24} in
        ''|*[!0-9]*) MOSS_INDEX_TTL=24 ;;
    esac
    [ "$MOSS_INDEX_TTL" -eq 0 ] && return 1
    _moss_f_min=$((MOSS_INDEX_TTL * 60))
    if [ -n "$(find "$_moss_f_file" -mmin "+$_moss_f_min" 2>/dev/null)" ]; then
        return 1
    fi
    return 0
}

# Descarga y actualiza el indice TSV local desde el servidor remoto.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_INDEX_URL, MOSS_TMPDIR
# Retorna:
#   0 en exito, 2 si falla la descarga
moss_index_refresh() {
    _moss_r_cache=$(moss_index_cache_file)
    mkdir -p "$(dirname "$_moss_r_cache")"
    if moss_download "$MOSS_INDEX_URL" "$_moss_r_cache.tmp"; then
        mv "$_moss_r_cache.tmp" "$_moss_r_cache"
        return 0
    fi
    rm -f "$_moss_r_cache.tmp"
    return $MOSS_EX_DOWNLOAD
}

# Carga la base de datos de paquetes y actualiza si es necesario.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_OFFLINE, MOSS_INDEX_URL
# Retorna:
#   0 si el indice esta disponible y formateado adecuadamente, 2 en fallo
moss_index_load() {
    [ -n "${MOSS_INDEX_URL:-}" ] || {
        moss_log ERROR "no hay indice configurado (MOSS_INDEX_URL, --index o ~/.config/moss/config)"
        return $MOSS_EX_USAGE
    }
    case $MOSS_INDEX_URL in
        *'<user>'*)
            printf "MOSS_INDEX_URL no configurado.\n" >&2
            printf "Introduce la URL o ruta de tu indice: " >&2
            read -r _moss_new_url < /dev/tty || return $MOSS_EX_USAGE
            MOSS_INDEX_URL="$_moss_new_url"
            
            _moss_cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/moss"
            mkdir -p "$_moss_cfg_dir"
            if [ -f "$_moss_cfg_dir/config" ]; then
                _moss_tmp_cfg="$_moss_cfg_dir/config.$$"
                grep -v "^MOSS_INDEX_URL=" "$_moss_cfg_dir/config" > "$_moss_tmp_cfg" 2>/dev/null || :
                printf "MOSS_INDEX_URL='%s'\n" "$_moss_new_url" >> "$_moss_tmp_cfg"
                mv "$_moss_tmp_cfg" "$_moss_cfg_dir/config"
            else
                printf "MOSS_INDEX_URL='%s'\n" "$_moss_new_url" > "$_moss_cfg_dir/config"
            fi
            moss_log INFO "Configuracion guardada en $_moss_cfg_dir/config"
            ;;
    esac
    if ! moss_index_source_is_url; then
        [ -f "$MOSS_INDEX_URL" ] || {
            moss_log ERROR "indice no encontrado: $MOSS_INDEX_URL"
            return $MOSS_EX_USAGE
        }
        _moss_index_file=$MOSS_INDEX_URL
        return 0
    fi
    _moss_il_cache=$(moss_index_cache_file)
    if [ "$MOSS_SYNC_FORCE" -eq 1 ]; then
        moss_index_refresh || return $MOSS_EX_DOWNLOAD
        _moss_index_file=$_moss_il_cache
        return 0
    fi
    if moss_index_fresh "$_moss_il_cache"; then
        _moss_index_file=$_moss_il_cache
        return 0
    fi
    if [ "$MOSS_OFFLINE" -eq 1 ]; then
        if [ -f "$_moss_il_cache" ]; then
            moss_log WARN "offline: se usa el cache del indice aunque este vencido"
            _moss_index_file=$_moss_il_cache
            return 0
        fi
        moss_log ERROR "modo offline y no hay cache del indice"
        return $MOSS_EX_DOWNLOAD
    fi
    if moss_index_refresh; then
        _moss_index_file=$_moss_il_cache
        return 0
    fi
    if [ -f "$_moss_il_cache" ]; then
        moss_log WARN "no se pudo refrescar el indice; se usa el cache disponible"
        _moss_index_file=$_moss_il_cache
        return 0
    fi
    moss_log ERROR "no se pudo descargar el indice y no hay cache"
    return $MOSS_EX_DOWNLOAD
}

# Busca un paquete por nombre exacto en el indice global.
#
# Argumentos:
#   $1 - Nombre del paquete
# Globales:
#   MOSS_L_NAME, MOSS_L_VERSION, MOSS_L_URL, MOSS_L_SHA, MOSS_L_DESC, MOSS_L_EXEC
# Retorna:
#   0 y puebla variables globales si lo encuentra, 1 si no
moss_index_lookup() {
    _moss_l_line=$(awk -F "$MOSS_TAB" -v n="$1" \
        '$1 !~ /^#/ && $1 == n { print; exit }' "$_moss_index_file")
    [ -n "$_moss_l_line" ] || return 1
    MOSS_L_VERSION='' MOSS_L_URL='' MOSS_L_SHA='' MOSS_L_DESC='' MOSS_L_EXEC='' MOSS_L_SIG='' MOSS_L_CAT='' MOSS_L_TERM=''
    IFS=$MOSS_TAB read -r _moss_l_name MOSS_L_VERSION MOSS_L_URL MOSS_L_SHA MOSS_L_DESC MOSS_L_EXEC MOSS_L_CAT MOSS_L_TERM MOSS_L_SIG << EOF
$_moss_l_line
EOF
    [ -z "$MOSS_L_CAT" ] || [ "$MOSS_L_CAT" = "-" ] && MOSS_L_CAT="Utility"
    [ -z "$MOSS_L_TERM" ] || [ "$MOSS_L_TERM" = "-" ] && MOSS_L_TERM="N"
    return 0
}

# Lee el manifiesto de un paquete instalado y carga sus variables en el entorno.
#
# Argumentos:
#   $1 - Ruta al archivo manifest
# Globales:
#   MOSS_M_NAME, MOSS_M_VERSION, MOSS_M_URL, MOSS_M_SHA, MOSS_M_PREFIX, MOSS_M_TARBALL, MOSS_M_DATE
# Retorna:
#   0 si es valido, 1 si no se puede leer
moss_manifest_read() {
    MOSS_M_NAME='' MOSS_M_VERSION='' MOSS_M_URL='' MOSS_M_SHA='' MOSS_M_PREFIX=''
    MOSS_M_TARBALL='' MOSS_M_DATE=''
    [ -f "$1" ] || return 1
    while IFS='=' read -r _moss_r_key _moss_r_val; do
        case $_moss_r_key in
            name)         MOSS_M_NAME=$_moss_r_val ;;
            version)      MOSS_M_VERSION=$_moss_r_val ;;
            url)          MOSS_M_URL=$_moss_r_val ;;
            sha256)       MOSS_M_SHA=$_moss_r_val ;;
            prefix)       MOSS_M_PREFIX=$_moss_r_val ;;
            tarball)      MOSS_M_TARBALL=$_moss_r_val ;;
            installed_at) MOSS_M_DATE=$_moss_r_val ;;
        esac
    done < "$1"
}

# Escribe las propiedades del paquete en un archivo manifest seguro.
#
# Argumentos:
#   $1 - Ruta de destino
# Globales:
#   MOSS_P_NAME, MOSS_P_VERSION, MOSS_P_URL, MOSS_P_SHA, MOSS_P_PREFIX, MOSS_P_TARBALL
# Retorna:
#   0 si tiene exito, 1 si no
moss_write_manifest() {
    {
        printf 'name=%s\n' "$2"
        printf 'version=%s\n' "$3"
        printf 'url=%s\n' "$4"
        printf 'sha256=%s\n' "$5"
        printf 'prefix=%s\n' "$6"
        printf 'tarball=%s\n' "$7"
        printf 'installed_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$1"
}

# Extrae el paquete descargado segun su formato.
# Soporta tarballs, zip, bz2 individuales y binarios crudos.
#
# Argumentos:
#   $1 - Ruta al archivo descargado
#   $2 - Directorio temporal de destino (staging)
# Globales:
#   Ninguna
# Retorna:
#   0 en exito, 1 si falta una herramienta de extraccion
moss_extract() {
    if tar -xf "$1" -C "$2" 2>/dev/null; then
        return 0
    fi
    case $1 in
        *.tar.gz|*.tgz)   tar -xzf "$1" -C "$2" ;;
        *.tar.xz|*.txz)   tar -xJf "$1" -C "$2" ;;
        *.tar.bz2|*.tbz2) tar -xjf "$1" -C "$2" ;;
        *.zip)
            if command -v unzip >/dev/null 2>&1; then
                unzip -q "$1" -d "$2"
            else
                moss_log ERROR "comando 'unzip' no encontrado"
                return 1
            fi
            ;;
        *.bz2)
            if command -v bunzip2 >/dev/null 2>&1; then
                _moss_ex_bn=$(basename "$1" .bz2)
                bunzip2 -c "$1" > "$2/$_moss_ex_bn"
                chmod +x "$2/$_moss_ex_bn"
            else
                moss_log ERROR "comando 'bunzip2' no encontrado"
                return 1
            fi
            ;;
        *.AppImage|*.appimage|*.deb|*.rpm|*.exe|*.msi)
            moss_log ERROR "formato de paquete no soportado: $(basename "$1")"
            return 1
            ;;
        *)
            _moss_ex_bn=$(basename "$1")
            cp "$1" "$2/$_moss_ex_bn"
            chmod +x "$2/$_moss_ex_bn"
            return 0
            ;;
    esac
}

# Normaliza el directorio de staging eliminando envolturas innecesarias.
#
# Argumentos:
#   $1 - Directorio de staging
# Globales:
#   Ninguna
# Retorna:
#   0 siempre
moss_normalize_staging() {
    _moss_n_entries=$(ls -A "$1" 2>/dev/null | sed '/^$/d')
    _moss_n_count=$(printf '%s\n' "$_moss_n_entries" | wc -l | tr -dc '0-9')
    if [ "$_moss_n_count" -eq 1 ] && [ -d "$1/$_moss_n_entries" ]; then
        mv "$1" "$1.orig" &&
        mv "$1.orig/$_moss_n_entries" "$1" &&
        rm -rf "$1.orig"
    fi
}

# Genera una lista de rutas relativas de los archivos en staging.
#
# Argumentos:
#   $1 - Directorio base
# Globales:
#   Ninguna
# Retorna:
#   0, imprime lista en stdout
moss_build_filelist() {
    ( cd "$1" && find . \( -type f -o -type l \) -print ) |
        sed 's|^\./||' | LC_ALL=C sort > "$2"
}

# Verifica si los archivos a instalar ya existen y previene colisiones.
#
# Argumentos:
#   $1 - Ruta a la lista de archivos
#   $2 - Directorio de destino base
# Globales:
#   MOSS_FORCE
# Retorna:
#   0 si no hay conflicto, 5 si detecta solapamiento
moss_check_conflicts() {
    _moss_k_n=0
    _moss_k_any=0
    while IFS= read -r _moss_k_f; do
        if [ -e "$MOSS_PREFIX/$_moss_k_f" ]; then
            _moss_k_any=1
            if [ "$_moss_k_n" -lt 20 ]; then
                moss_log WARN "existe: $MOSS_PREFIX/$_moss_k_f"
                _moss_k_n=$((_moss_k_n + 1))
            fi
        fi
    done < "$1"
    [ "$_moss_k_n" -ge 20 ] && moss_log WARN "(mas conflictos omitidos...)"
    return "$_moss_k_any"
}

# Elimina un directorio y todos sus padres recursivamente si quedan vacios.
#
# Argumentos:
#   $1 - Ruta del directorio base
#   $2 - Directorio raiz a no superar
# Globales:
#   Ninguna
# Retorna:
#   0 siempre
moss_rmdir_chain() {
    _moss_rc_d=$(dirname "$1")
    while [ "$_moss_rc_d" != "." ] && [ "$MOSS_PREFIX/$_moss_rc_d" != "$MOSS_PREFIX" ]; do
        rmdir "$MOSS_PREFIX/$_moss_rc_d" 2>/dev/null || break
        _moss_rc_d=$(dirname "$_moss_rc_d")
    done
}

# Copia fisicamente los archivos del paquete al sistema de destino definitivo.
#
# Argumentos:
#   $1 - Directorio fuente (staging)
#   $2 - Directorio destino (prefix)
#   $3 - Nombre del paquete
#   $4 - Archivo temporal de lista
# Globales:
#   Ninguna
# Retorna:
#   0 si tiene exito copiado completo
moss_install_files() {
    _moss_if_installed=$MOSS_TMPDIR/installed.$$
    
    if ! ( cd "$1" && tar cf - . ) | ( cd "$MOSS_PREFIX" && tar xf - 2>/dev/null ); then
        moss_log ERROR "fallo en la copia masiva; revirtiendo cambios parciales"
        ( cd "$1" && find . -type f 2>/dev/null ) | sed 's|^\./||' | while IFS= read -r _moss_if_g; do
            [ -n "$_moss_if_g" ] || continue
            rm -f "$MOSS_PREFIX/$_moss_if_g"
            moss_rmdir_chain "$_moss_if_g"
        done
        return 1
    fi

    ( cd "$1" && find . ! -type d 2>/dev/null ) | sed 's|^\./||' > "$_moss_if_installed"
    mv "$_moss_if_installed" "$3"
    return 0
}

# Elimina todos los archivos y metadatos asociados a un paquete instalado.
#
# Argumentos:
#   $1 - ID exacto del paquete
# Globales:
#   MOSS_STATE_DIR, MOSS_PREFIX
# Retorna:
#   0 en exito, 1 si no esta instalado, u otro codigo en fallo de operacion
moss_remove_pkg() {
    _moss_rm_d=$MOSS_STATE_DIR/$1
    _moss_rm_prefix=$MOSS_PREFIX
    if [ -f "$_moss_rm_d/manifest" ]; then
        while IFS='=' read -r _moss_rm_k _moss_rm_v; do
            [ "$_moss_rm_k" = prefix ] && _moss_rm_prefix=$_moss_rm_v
        done < "$_moss_rm_d/manifest"
    fi
    
    moss_log INFO "Iniciando desinstalacion de: $1"
    
    if [ -f "$_moss_rm_d/files" ]; then
        _moss_rm_tot=$(wc -l < "$_moss_rm_d/files" | tr -dc '0-9')
        if [ "$_moss_rm_tot" -gt 0 ]; then
            [ "$MOSS_LOG_LEVEL" -lt 3 ] && moss_progress 0 "$_moss_rm_tot" "Preparando..."
            
            _moss_rm_curr=0
            LC_ALL=C sort -r "$_moss_rm_d/files" | while IFS= read -r _moss_rm_f; do
                case "$_moss_rm_f" in
                    /*) _moss_rm_tgt="$_moss_rm_f" ;;
                    *)  _moss_rm_tgt="$_moss_rm_prefix/$_moss_rm_f" ;;
                esac
                
                [ "$MOSS_LOG_LEVEL" -ge 3 ] && moss_log DEBUG "eliminando: $_moss_rm_tgt"
                rm -f "$_moss_rm_tgt"
            
                case "$_moss_rm_f" in
                    /*) ;;
                    *)
                        _moss_rm_save=$MOSS_PREFIX
                        MOSS_PREFIX=$_moss_rm_prefix
                        moss_rmdir_chain "$_moss_rm_f"
                        MOSS_PREFIX=$_moss_rm_save
                        ;;
                esac
            
                _moss_rm_curr=$((_moss_rm_curr + 1))
                if [ "$MOSS_LOG_LEVEL" -lt 3 ]; then
                    if [ $((_moss_rm_curr % 25)) -eq 0 ] || [ "$_moss_rm_curr" -eq "$_moss_rm_tot" ]; then
                        moss_progress "$_moss_rm_curr" "$_moss_rm_tot" "Eliminando archivos..."
                    fi
                fi
            done
        fi
    fi
    rm -rf "$_moss_rm_d"
}

# Orquesta de principio a fin el flujo completo de instalacion de un tarball.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_P_NAME, MOSS_P_VERSION, MOSS_P_URL, MOSS_P_SHA, MOSS_P_LOCAL, MOSS_P_SIG, MOSS_P_EXEC
# Retorna:
#   0 en exito total de instalacion, exit >0 en cualquier falla critica
moss_perform_install() {
    _moss_p_name=$1
    _moss_p_version=$2
    _moss_p_url=$3
    _moss_p_sha=$4
    _moss_p_sig=$5
    _moss_p_local=$6
    _moss_p_exec_override=$7
    _moss_p_cat=${8:-Utility}
    _moss_p_term=${9:-N}

    moss_log INFO "Instalando paquete: $_moss_p_name"

    if [ -n "$_moss_p_local" ]; then
        _moss_p_src=$_moss_p_local
    else
        _moss_p_base=$(basename "$_moss_p_url")
        if [ -n "$_moss_p_sha" ]; then
            _moss_p_cache=$MOSS_CACHE_DIR/$_moss_p_sha-$_moss_p_base
        else
            _moss_p_cache=$MOSS_CACHE_DIR/$_moss_p_base
        fi
        if [ ! -f "$_moss_p_cache" ]; then
            moss_log STEP "Descargando desde el repositorio..."
            if ! moss_download "$_moss_p_url" "$_moss_p_cache"; then
                rm -f "$_moss_p_cache"
                moss_log ERROR "fallo la descarga de $_moss_p_url"
                return $MOSS_EX_DOWNLOAD
            fi
        fi
        _moss_p_src=$_moss_p_cache
    fi

    if [ -n "$_moss_p_sha" ]; then
        moss_log STEP "Verificando integridad (SHA256)..."
        _moss_p_got=$(moss_sha256 "$_moss_p_src") || {
            moss_log ERROR "no hay herramienta de sha256 (sha256sum/shasum/openssl)"
            return $MOSS_EX_DEP
        }
        if [ "$_moss_p_got" != "$_moss_p_sha" ]; then
            moss_log ERROR "checksum sha256 invalido para $_moss_p_name"
            moss_log ERROR "esperado: $_moss_p_sha"
            moss_log ERROR "obtenido: $_moss_p_got"
            return $MOSS_EX_VERIFY
        fi
        moss_log DEBUG "checksum ok: $_moss_p_got"
    else
        moss_log WARN "$_moss_p_name: sin checksum en el indice; no se verifica integridad"
    fi

    if [ -n "$_moss_p_sig" ] && [ "$_moss_p_sig" != "-" ]; then
        if command -v gpg >/dev/null 2>&1; then
            _moss_p_sigfile=$MOSS_TMPDIR/pkg.$$.sig
            if ! moss_download "$_moss_p_sig" "$_moss_p_sigfile"; then
                moss_log ERROR "no se pudo descargar la firma $_moss_p_sig"
                return $MOSS_EX_DOWNLOAD
            fi
            if ! gpg --verify "$_moss_p_sigfile" "$_moss_p_src" >/dev/null 2>&1; then
                moss_log ERROR "firma GPG invalida para $_moss_p_name"
                return $MOSS_EX_VERIFY
            fi
            moss_log DEBUG "firma gpg ok"
        else
            moss_log WARN "hay firma GPG en el indice pero gpg no esta instalado; se omite"
        fi
    fi

    moss_log STEP "Extrayendo archivos temporales..."
    _moss_p_staging=$MOSS_TMPDIR/staging.$$
    rm -rf "$_moss_p_staging"
    mkdir -p "$_moss_p_staging" || return $MOSS_EX_INSTALL
    if ! moss_extract "$_moss_p_src" "$_moss_p_staging"; then
        moss_log ERROR "no se pudo extraer $_moss_p_src"
        return $MOSS_EX_INSTALL
    fi
    moss_normalize_staging "$_moss_p_staging"

    _moss_p_list=$MOSS_TMPDIR/files.$$
    moss_build_filelist "$_moss_p_staging" "$_moss_p_list"
    if [ ! -s "$_moss_p_list" ]; then
        moss_log WARN "$_moss_p_name: el tarball no contiene archivos regulares"
    fi

    _moss_p_filecount=$(wc -l < "$_moss_p_list" | tr -dc '0-9')
    _moss_p_opt_staging="$MOSS_TMPDIR/sandbox.$$"
    
    if [ "$_moss_p_filecount" -gt 100 ]; then
        moss_log INFO "paquete masivo detectado ($_moss_p_filecount archivos), activando sandbox en opt/$_moss_p_name"
        mkdir -p "$_moss_p_opt_staging/opt/$_moss_p_name"
        
        for _moss_sb_f in "$_moss_p_staging"/* "$_moss_p_staging"/.[!.]*; do
            [ -e "$_moss_sb_f" ] || continue
            mv "$_moss_sb_f" "$_moss_p_opt_staging/opt/$_moss_p_name/"
        done
    else
        moss_log INFO "paquete normal detectado ($_moss_p_filecount archivos), instalando en pkg/$_moss_p_name"
        mkdir -p "$_moss_p_opt_staging/pkg/$_moss_p_name"
        
        for _moss_sb_f in "$_moss_p_staging"/* "$_moss_p_staging"/.[!.]*; do
            [ -e "$_moss_sb_f" ] || continue
            mv "$_moss_sb_f" "$_moss_p_opt_staging/pkg/$_moss_p_name/"
        done
    fi
    
    rm -rf "$_moss_p_staging"
    mv "$_moss_p_opt_staging" "$_moss_p_staging"
    
    moss_build_filelist "$_moss_p_staging" "$_moss_p_list"

    if [ "$MOSS_DRY_RUN" -eq 1 ]; then
        _moss_p_count=$(wc -l < "$_moss_p_list" | tr -dc '0-9')
        moss_log INFO "[dry-run] se instalaria $_moss_p_name $_moss_p_version"
        moss_log INFO "[dry-run] destino: $MOSS_PREFIX (archivos: $_moss_p_count)"
        while IFS= read -r _moss_p_f; do
            moss_log INFO "[dry-run]   + $MOSS_PREFIX/$_moss_p_f"
        done < "$_moss_p_list"
        return 0
    fi

    _moss_p_state=$MOSS_STATE_DIR/$_moss_p_name
    if [ -f "$_moss_p_state/manifest" ]; then
        if [ "$MOSS_FORCE" -eq 1 ]; then
            moss_log INFO "$_moss_p_name ya esta gestionado; se reemplaza (--force)"
            [ -f "$_moss_p_state/manifest.bak" ] &&
                mv "$_moss_p_state/manifest.bak" "$MOSS_TMPDIR/keep-manifest.$$"
            [ -f "$_moss_p_state/files.bak" ] &&
                mv "$_moss_p_state/files.bak" "$MOSS_TMPDIR/keep-files.$$"
            moss_remove_pkg "$_moss_p_name" || {
                [ -f "$MOSS_TMPDIR/keep-manifest.$$" ] &&
                    mv "$MOSS_TMPDIR/keep-manifest.$$" "$_moss_p_state/manifest.bak"
                [ -f "$MOSS_TMPDIR/keep-files.$$" ] &&
                    mv "$MOSS_TMPDIR/keep-files.$$" "$_moss_p_state/files.bak"
                return $MOSS_EX_INSTALL
            }
            mkdir -p "$_moss_p_state"
            [ -f "$MOSS_TMPDIR/keep-manifest.$$" ] &&
                mv "$MOSS_TMPDIR/keep-manifest.$$" "$_moss_p_state/manifest.bak"
            [ -f "$MOSS_TMPDIR/keep-files.$$" ] &&
                mv "$MOSS_TMPDIR/keep-files.$$" "$_moss_p_state/files.bak"
        else
            moss_log ERROR "$_moss_p_name ya esta instalado (usa --force para reinstalar)"
            return $MOSS_EX_CONFLICT
        fi
    fi

    if ! moss_check_conflicts "$_moss_p_list"; then
        if [ "$MOSS_FORCE" -eq 1 ]; then
            moss_log WARN "conflictos con archivos existentes; se sobrescriben (--force)"
        else
            moss_log ERROR "conflictos con archivos existentes; abortando (usa --force)"
            return $MOSS_EX_CONFLICT
        fi
    fi

    mkdir -p "$_moss_p_state"
    if ! moss_install_files "$_moss_p_staging" "$_moss_p_list" "$_moss_p_state/files"; then
        rmdir "$_moss_p_state" 2>/dev/null
        return $MOSS_EX_INSTALL
    fi

    moss_write_manifest "$_moss_p_state/manifest" "$_moss_p_name" "$_moss_p_version" \
        "$_moss_p_url" "$_moss_p_sha" "$MOSS_PREFIX" "$(basename "$_moss_p_src")"
    
    moss_log STEP "Configurando ejecutable y enlaces..."
    _moss_desk_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    [ "$MOSS_SYSTEM" -eq 1 ] && _moss_desk_dir="/usr/share/applications"
    
    _moss_candidates=""
    _moss_cand_count=0
    while IFS= read -r _moss_raw_file; do
        _moss_file=${_moss_raw_file#./}
        
        case "$_moss_file" in
            *.so | *.so.* | *.pak | *.dat | *.bin | *.html | *.txt | *.json | */node_modules/*)
                continue
                ;;
        esac
        
        _moss_cand="$MOSS_PREFIX/$_moss_file"
        if [ -e "$_moss_cand" ] && [ ! -d "$_moss_cand" ] && [ -x "$_moss_cand" ]; then
            if [ -z "$_moss_candidates" ]; then
                _moss_candidates="$_moss_cand"
            else
                _moss_candidates="$_moss_candidates
$_moss_cand"
            fi
            _moss_cand_count=$((_moss_cand_count + 1))
        fi
    done < "$_moss_p_state/files"

    _moss_exec_path=""
    if [ -n "$_moss_p_exec_override" ]; then
        if [ -x "$MOSS_PREFIX/$_moss_p_exec_override" ]; then
            _moss_exec_path="$MOSS_PREFIX/$_moss_p_exec_override"
        elif [ -x "$MOSS_PREFIX/bin/$_moss_p_exec_override" ]; then
            _moss_exec_path="$MOSS_PREFIX/bin/$_moss_p_exec_override"
        elif [ -n "$_moss_candidates" ]; then
            _moss_exec_path=$(printf '%s\n' "$_moss_candidates" | grep -E "/$_moss_p_exec_override$" | head -n 1)
        fi
        [ -z "$_moss_exec_path" ] && moss_log WARN "el ejecutable forzado $_moss_p_exec_override no se encontro o no tiene permisos"
    fi

    if [ -z "$_moss_exec_path" ]; then
        if [ "$_moss_cand_count" -eq 0 ]; then
            moss_log WARN "no se encontraron ejecutables validos para generar .desktop"
        elif [ "$_moss_cand_count" -eq 1 ]; then
            _moss_exec_path="$_moss_candidates"
        else
        _moss_exec_path=$(printf '%s\n' "$_moss_candidates" | awk -v pkg="$_moss_p_name" '
            BEGIN { 
                norm_pkg = tolower(pkg); gsub(/[-_ ]/, "", norm_pkg)
            }
            {
                bn = $0; sub(".*/", "", bn);
                norm_bn = tolower(bn); gsub(/[-_ ]/, "", norm_bn)
                
                if (norm_bn == norm_pkg) { exact = $0 }
                else if (index(norm_bn, norm_pkg) == 1) { starts = $0 }
                else if (bn != "chrome-sandbox" && bn !~ /crashpad/ && bn !~ /\.so/ && bn != "libEGL.so" && bn != "libvulkan.so" && bn != "libGLESv2.so") { 
                    if (!fallback) fallback = $0 
                }
            }
            END {
                if (exact) print exact
                else if (starts) print starts
                else if (fallback) print fallback
                else print ""
            }
        ')
        if [ -z "$_moss_exec_path" ]; then
            _moss_exec_path=$(printf '%s\n' "$_moss_candidates" | awk 'NR==1 {print $0}')
        fi
        moss_log WARN "Multiples ejecutables encontrados, auto-seleccionando: $(basename "$_moss_exec_path")"
        fi
    fi

    if [ -n "$_moss_exec_path" ]; then
        if [ "$_moss_p_term" = "Y" ]; then
            moss_log DEBUG "aplicacion de terminal; omitiendo creacion de .desktop"
        else
            mkdir -p "$_moss_desk_dir" 2>/dev/null
            _moss_desk_file="$_moss_desk_dir/moss-$_moss_p_name.desktop"
            
            _moss_term_val="false"
            [ "$MOSS_OPT_TERM" = "1" ] && _moss_term_val="true"
            
            cat <<EOF > "$_moss_desk_file"
[Desktop Entry]
Version=1.0
Name=${MOSS_P_APP_NAME:-$_moss_p_name}
Comment=Instalado via moss
Exec="$_moss_exec_path" %U
Terminal=$_moss_term_val
Type=Application
Categories=${_moss_p_cat};
EOF
            printf '%s\n' "$_moss_desk_file" >> "$_moss_p_state/files"
            moss_log INFO "acceso directo creado: $_moss_desk_file"
            
            command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$_moss_desk_dir"
        fi
        
        mkdir -p "$MOSS_PREFIX/bin"
        _moss_rel_target="../${_moss_exec_path#"$MOSS_PREFIX/"}"
        _moss_bin_name=$(basename "$_moss_exec_path")
        _moss_symlink="$MOSS_PREFIX/bin/$_moss_bin_name"
        ln -sf "$_moss_rel_target" "$_moss_symlink"
        printf 'bin/%s\n' "$_moss_bin_name" >> "$_moss_p_state/files"
        moss_log INFO "enlace symlink creado: bin/$_moss_bin_name -> $_moss_rel_target"
    fi

    moss_log SUCCESS "Paquete '$_moss_p_name' instalado y listo para usar."
    return 0
}

# Interpreta el argumento de usuario resolviendolo como URL, local o indice.
#
# Argumentos:
#   $1 - Cadena provista por el usuario
# Globales:
#   MOSS_R_NAME, MOSS_R_VERSION, MOSS_R_URL, MOSS_R_SHA, MOSS_R_LOCAL, MOSS_R_SIG, MOSS_R_EXEC
# Retorna:
#   0 en resolucion valida, exit 1 si el origen es inviable o no existe
moss_resolve_pkg() {
    if [ -f "$1" ]; then
        _moss_res_base=$(basename "$1")
        MOSS_R_NAME=$(printf '%s' "$_moss_res_base" | sed \
            's/\.tar\.gz$//; s/\.tar\.xz$//; s/\.tar\.bz2$//; s/\.tar\.zst$//;
             s/\.tgz$//; s/\.txz$//; s/\.tbz2$//')
        [ -n "$MOSS_R_NAME" ] || MOSS_R_NAME=$_moss_res_base
        MOSS_R_VERSION=local
        MOSS_R_URL=$1
        MOSS_R_SHA=$(moss_sha256 "$1" 2>/dev/null || printf '')
        MOSS_R_SIG=''
        MOSS_R_EXEC=''
        MOSS_R_CAT='Utility'
        MOSS_R_TERM='N'
        MOSS_R_LOCAL=$1
        return 0
    fi
    case $1 in
        http://*|https://*|file://*)
            _moss_res_base=$(basename "$1")
            MOSS_R_NAME=$(printf '%s' "$_moss_res_base" | sed \
                's/\.tar\.gz$//; s/\.tar\.xz$//; s/\.tar\.bz2$//; s/\.tar\.zst$//;
                 s/\.tgz$//; s/\.txz$//; s/\.tbz2$//')
            [ -n "$MOSS_R_NAME" ] || MOSS_R_NAME=$_moss_res_base
            MOSS_R_VERSION=direct
            MOSS_R_URL=$1
            MOSS_R_SHA=''
            MOSS_R_SIG=''
            MOSS_R_EXEC=''
            MOSS_R_CAT='Utility'
            MOSS_R_TERM='N'
            MOSS_R_LOCAL=''
            return 0
            ;;
    esac
    moss_index_load || return $?
    if ! moss_index_lookup "$1"; then
        moss_log ERROR "paquete no encontrado en el indice: $1"
        return $MOSS_EX_USAGE
    fi
    MOSS_R_NAME=$1
    MOSS_R_VERSION=$MOSS_L_VERSION
    MOSS_R_URL=$MOSS_L_URL
    MOSS_R_SHA=$MOSS_L_SHA
    MOSS_R_SIG=$MOSS_L_SIG
    MOSS_R_EXEC=$MOSS_L_EXEC
    MOSS_R_CAT=$MOSS_L_CAT
    MOSS_R_TERM=$MOSS_L_TERM
    MOSS_R_LOCAL=''
    return 0
}

# Comando principal 'install': procesa las banderas y orquesta instalaciones.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_DRY_RUN, MOSS_FORCE, MOSS_SYSTEM, MOSS_LOG_LEVEL, MOSS_OPT_EXEC
# Retorna:
#   0 o aborta el script en errores
moss_cmd_install() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    MOSS_OPT_EXEC=""
    while getopts ':hnfsqjve:t' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            n) MOSS_DRY_RUN=1 ;;
            f) MOSS_FORCE=1 ;;
            s) MOSS_SYSTEM=1 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            e) MOSS_OPT_EXEC="$OPTARG" ;;
            t) MOSS_OPT_TERM=1 ;;
            :) moss_die $MOSS_EX_USAGE "falta argumento para -$OPTARG" ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP

    moss_resolve_pkg "$1"
    _moss_i_rc=$?
    [ "$_moss_i_rc" -ne 0 ] && exit "$_moss_i_rc"

    moss_perform_install "$MOSS_R_NAME" "$MOSS_R_VERSION" "$MOSS_R_URL" \
        "$MOSS_R_SHA" "$MOSS_R_SIG" "$MOSS_R_LOCAL" "${MOSS_OPT_EXEC:-$MOSS_R_EXEC}" "$MOSS_R_CAT" "$MOSS_R_TERM"
    exit $?
}

# Comando principal 'remove': resuelve nombres de paquete/binario e invoca borrado.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_FORCE, MOSS_STATE_DIR, MOSS_PREFIX
# Retorna:
#   0 si el paquete fue borrado o no existia, aborta en error general
moss_cmd_remove() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hfsyqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            f) MOSS_FORCE=1 ;;
            s) MOSS_SYSTEM=1 ;;
            y) MOSS_ASSUME_YES=1 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            :) moss_die $MOSS_EX_USAGE "falta argumento para -$OPTARG" ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP
    _moss_rm_name=$1

    if [ ! -f "$MOSS_STATE_DIR/$_moss_rm_name/manifest" ]; then
        _moss_rm_resolved=""
        if [ -h "$MOSS_PREFIX/bin/$_moss_rm_name" ]; then
            _moss_rm_target=$(readlink "$MOSS_PREFIX/bin/$_moss_rm_name")
            _moss_rm_resolved=$(printf '%s\n' "$_moss_rm_target" | awk -F/ '{print $3}')
            if [ -n "$_moss_rm_resolved" ] && [ -f "$MOSS_STATE_DIR/$_moss_rm_resolved/manifest" ]; then
                moss_log INFO "resolviendo binario '$_moss_rm_name' al paquete '$_moss_rm_resolved'"
                _moss_rm_name="$_moss_rm_resolved"
            else
                _moss_rm_resolved=""
            fi
        fi
        
        if [ -z "$_moss_rm_resolved" ]; then
            moss_die $MOSS_EX_USAGE "no esta instalado: $_moss_rm_name"
        fi
    fi

    if moss_remove_pkg "$_moss_rm_name"; then
        moss_log SUCCESS "Paquete '$_moss_rm_name' eliminado completamente."
        exit $MOSS_EX_OK
    fi
    moss_die $MOSS_EX_INSTALL "no se pudo eliminar $_moss_rm_name"
}

# Compara y ejecuta la actualizacion individual para un solo paquete.
#
# Argumentos:
#   $1 - Nombre del paquete
# Globales:
#   MOSS_STATE_DIR, MOSS_U_RESULT
# Retorna:
#   0 en exito/sin cambios, 1 en fallo
moss_update_one() {
    MOSS_U_RESULT=uptodate
    _moss_u_state=$MOSS_STATE_DIR/$1
    if ! moss_manifest_read "$_moss_u_state/manifest"; then
        moss_log ERROR "no esta instalado: $1"
        MOSS_U_RESULT=failed
        return 1
    fi
    if ! moss_index_load; then
        moss_log ERROR "indice no disponible"
        MOSS_U_RESULT=failed
        return 1
    fi
    if ! moss_index_lookup "$1"; then
        moss_log WARN "$1 no esta en el indice; se omite"
        MOSS_U_RESULT=skipped
        return 0
    fi
    if [ "$(moss_version_gt "$MOSS_L_VERSION" "$MOSS_M_VERSION")" != 1 ]; then
        moss_log INFO "$1 ya esta al dia ($MOSS_M_VERSION)"
        return 0
    fi
    if [ "$MOSS_DRY_RUN" -eq 1 ]; then
        moss_log INFO "[dry-run] $1: $MOSS_M_VERSION -> $MOSS_L_VERSION"
        MOSS_U_RESULT=updated
        return 0
    fi
    moss_log INFO "actualizando $1: $MOSS_M_VERSION -> $MOSS_L_VERSION"

    cp "$_moss_u_state/manifest" "$_moss_u_state/manifest.bak"
    [ -f "$_moss_u_state/files" ] && cp "$_moss_u_state/files" "$_moss_u_state/files.bak"

    _moss_u_force=$MOSS_FORCE
    MOSS_FORCE=1
    moss_perform_install "$1" "$MOSS_L_VERSION" "$MOSS_L_URL" "$MOSS_L_SHA" "$MOSS_L_SIG" ''
    _moss_u_rc=$?
    if [ "$_moss_u_rc" -eq 0 ]; then
        MOSS_FORCE=$_moss_u_force
        MOSS_U_RESULT=updated
        return 0
    fi
    moss_log ERROR "fallo la actualizacion de $1 (rc=$_moss_u_rc)"

    _moss_u_src=''
    _moss_u_cache=$MOSS_CACHE_DIR/$MOSS_M_TARBALL
    if [ -f "$_moss_u_cache" ] && [ -n "$MOSS_M_SHA" ] &&
       [ "$(moss_sha256 "$_moss_u_cache" 2>/dev/null)" = "$MOSS_M_SHA" ]; then
        _moss_u_src=$_moss_u_cache
    else
        _moss_u_dl=$MOSS_TMPDIR/update-old.$$
        if moss_download "$MOSS_M_URL" "$_moss_u_dl" 2>/dev/null; then
            _moss_u_got=$(moss_sha256 "$_moss_u_dl" 2>/dev/null || printf '')
            if [ -z "$MOSS_M_SHA" ] || [ "$_moss_u_got" = "$MOSS_M_SHA" ]; then
                _moss_u_src=$_moss_u_dl
                cp "$_moss_u_dl" "$_moss_u_cache" 2>/dev/null || :
            fi
        fi
    fi
    if [ -n "$_moss_u_src" ] &&
       moss_perform_install "$1" "$MOSS_M_VERSION" "$MOSS_M_URL" "$MOSS_M_SHA" '' "$_moss_u_src"; then
        moss_log INFO "se revirtio automaticamente a $1 $MOSS_M_VERSION"
        moss_write_manifest "$_moss_u_state/manifest.bak" "$1" "$MOSS_L_VERSION" \
            "$MOSS_L_URL" "$MOSS_L_SHA" "$MOSS_PREFIX" \
            "$MOSS_L_SHA-$(basename "$MOSS_L_URL")"
    else
        mv "$_moss_u_state/manifest.bak" "$_moss_u_state/manifest"
        [ -f "$_moss_u_state/files.bak" ] && mv "$_moss_u_state/files.bak" "$_moss_u_state/files"
        moss_log WARN "no fue posible revertir automaticamente; ejecuta 'moss rollback $1'"
    fi
    MOSS_FORCE=$_moss_u_force
    MOSS_U_RESULT=failed
    return "$_moss_u_rc"
}

# Comando principal 'update': fuerza la actualizacion manual de uno o mas paquetes.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_JSON
# Retorna:
#   0
moss_cmd_update() {
    moss_state_init || return 1
    if [ "$#" -eq 2 ] && [ -f "$2" ]; then
        if [ ! -d "$MOSS_STATE_DIR/$1" ]; then
            moss_log ERROR "paquete no instalado: $1"
            return 1
        fi
        
        _moss_desk_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
        [ "$MOSS_SYSTEM" -eq 1 ] && _moss_desk_dir="/usr/share/applications"
        _moss_desk_file="$_moss_desk_dir/moss-$1.desktop"
        
        _moss_prev_name=""
        if [ -f "$_moss_desk_file" ]; then
            _moss_prev_name=$(sed -n 's/^Name=//p' "$_moss_desk_file" | head -n 1)
        fi
        
        export MOSS_R_NAME="$1"
        export MOSS_P_APP_NAME="${_moss_prev_name:-$1}"
        export MOSS_IS_LOCAL_UPDATE=1
        
        "$0" install -f "$2"
        return $?
    fi

    if [ "$#" -eq 0 ]; then
        case ${MOSS_INDEX_URL:-} in
            ''|*'<user>'*)
                moss_log ERROR "indice no configurado: define MOSS_INDEX_URL en ~/.config/moss/config"
                return 1
                ;;
        esac
        if ! moss_index_source_is_url; then
            moss_log INFO "fuente de indice local; nada que sincronizar"
            return 0
        fi
        
        moss_log INFO "Sincronizando repositorios..."
        if moss_index_refresh; then
            moss_log INFO "Repositorio actualizado -> $(moss_index_cache_file)"
            return 0
        else
            moss_log ERROR "Error al sincronizar el repositorio: $MOSS_INDEX_URL"
            return 1
        fi
    fi

    moss_log ERROR "Uso incorrecto. Argumentos esperados: 0 (sincronizar) o 2 (actualizacion local)."
    return 1
}

# Comando principal 'upgrade': itera e intenta actualizar todos los paquetes.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_STATE_DIR
# Retorna:
#   0 en exito
moss_cmd_upgrade() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hy' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            y) MOSS_ASSUME_YES=1 ;;
            :) moss_die $MOSS_EX_USAGE "falta argumento para -$OPTARG" ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))

    moss_state_init || return 1
    moss_index_load || return 1

    _moss_up_pkgs=""
    _moss_up_tot=0
    for _moss_s_dir in "$MOSS_STATE_DIR"/*; do
        [ -d "$_moss_s_dir" ] || continue
        _moss_p_name=$(basename "$_moss_s_dir")
        
        _moss_p_ver=""
        if [ -f "$_moss_s_dir/manifest" ]; then
            _moss_p_ver=$(awk -F= '$1=="version"{print $2; exit}' "$_moss_s_dir/manifest")
        fi
        
        if moss_index_lookup "$_moss_p_name"; then
            if [ "$_moss_p_ver" != "$MOSS_L_VERSION" ]; then
                _moss_up_pkgs="$_moss_up_pkgs $_moss_p_name"
                _moss_up_tot=$((_moss_up_tot + 1))
            fi
        fi
    done

    if [ "$_moss_up_tot" -eq 0 ]; then
        moss_log INFO "Todos los paquetes estan actualizados."
        return 0
    fi

    printf 'Se actualizarán los siguientes %d paquetes:\n  %s\n\n' "$_moss_up_tot" "$_moss_up_pkgs"

    if [ "${MOSS_ASSUME_YES:-0}" -ne 1 ]; then
        printf '¿Desea continuar con la actualización? [S/n] '
        read -r _moss_ans </dev/tty
        case "$_moss_ans" in
            [Nn]*)
                moss_log INFO "Actualización cancelada por el usuario."
                return 0
                ;;
        esac
    fi

    _moss_up_curr=0
    moss_progress "$_moss_up_curr" "$_moss_up_tot" "Calculando..."

    for _pkg in $_moss_up_pkgs; do
        moss_progress "$_moss_up_curr" "$_moss_up_tot" "Actualizando $_pkg..."
        
        "$0" install -f -q "$_pkg" >/dev/null 2>&1
        
        _moss_up_curr=$((_moss_up_curr + 1))
        moss_progress "$_moss_up_curr" "$_moss_up_tot" "$_pkg actualizado."
    done

    moss_log INFO "Actualizacion de $_moss_up_tot paquetes completada exitosamente."
}

# Comando principal 'rollback': restaura la configuracion previa tras fallo o pedido.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_STATE_DIR, MOSS_PREFIX
# Retorna:
#   0 si logra restaurar, aborta si no
moss_cmd_rollback() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hfsqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            f) MOSS_FORCE=1 ;;
            s) MOSS_SYSTEM=1 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            :) moss_die $MOSS_EX_USAGE "falta argumento para -$OPTARG" ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP
    _moss_rb_name=$1
    _moss_rb_state=$MOSS_STATE_DIR/$_moss_rb_name

    [ -f "$_moss_rb_state/manifest.bak" ] ||
        moss_die $MOSS_EX_USAGE "no hay respaldo para revertir: $_moss_rb_name"
    moss_manifest_read "$_moss_rb_state/manifest.bak"
    _moss_rb_version=$MOSS_M_VERSION
    _moss_rb_url=$MOSS_M_URL
    _moss_rb_sha=$MOSS_M_SHA
    _moss_rb_tarball=$MOSS_M_TARBALL

    _moss_rb_cache=$MOSS_CACHE_DIR/$_moss_rb_tarball
    if [ -f "$_moss_rb_cache" ] && [ -n "$_moss_rb_sha" ] &&
       [ "$(moss_sha256 "$_moss_rb_cache" 2>/dev/null)" = "$_moss_rb_sha" ]; then
        _moss_rb_src=$_moss_rb_cache
    else
        _moss_rb_src=$MOSS_TMPDIR/rollback.$$
        if ! moss_download "$_moss_rb_url" "$_moss_rb_src"; then
            moss_die $MOSS_EX_DOWNLOAD "no se pudo recuperar la version anterior de $_moss_rb_url"
        fi
        _moss_rb_got=$(moss_sha256 "$_moss_rb_src" 2>/dev/null || printf '')
        if [ -n "$_moss_rb_sha" ] && [ "$_moss_rb_got" != "$_moss_rb_sha" ]; then
            moss_die $MOSS_EX_VERIFY "el origen ya no contiene la version anterior (checksum distinto); rollback imposible"
        fi
        cp "$_moss_rb_src" "$_moss_rb_cache" 2>/dev/null || :
    fi

    mv "$_moss_rb_state/manifest" "$MOSS_TMPDIR/manifest.prev.$$"
    [ -f "$_moss_rb_state/files" ] && mv "$_moss_rb_state/files" "$MOSS_TMPDIR/files.prev.$$"

    _moss_rb_force=$MOSS_FORCE
    _moss_rb_dry=$MOSS_DRY_RUN
    MOSS_FORCE=1
    MOSS_DRY_RUN=0
    moss_perform_install "$_moss_rb_name" "$_moss_rb_version" "$_moss_rb_url" \
        "$_moss_rb_sha" '' "$_moss_rb_src"
    _moss_rb_rc=$?
    MOSS_FORCE=$_moss_rb_force
    MOSS_DRY_RUN=$_moss_rb_dry

    if [ "$_moss_rb_rc" -ne 0 ]; then
        mv "$MOSS_TMPDIR/manifest.prev.$$" "$_moss_rb_state/manifest"
        [ -f "$MOSS_TMPDIR/files.prev.$$" ] &&
            mv "$MOSS_TMPDIR/files.prev.$$" "$_moss_rb_state/files"
        moss_die $_moss_rb_rc "rollback fallido (rc=$_moss_rb_rc); estado restaurado"
    fi
    mv "$MOSS_TMPDIR/manifest.prev.$$" "$_moss_rb_state/manifest.bak"
    [ -f "$MOSS_TMPDIR/files.prev.$$" ] &&
        mv "$MOSS_TMPDIR/files.prev.$$" "$_moss_rb_state/files.bak"
    moss_log INFO "rollback completado: $_moss_rb_name -> $_moss_rb_version"
    exit $MOSS_EX_OK
}



# Lista unicamente los ID de los paquetes que se encuentran instalados.
#
# Argumentos:
#   Ninguno
# Globales:
#   MOSS_STATE_DIR
# Retorna:
#   0 e imprime nombres en stdout
moss_installed_names() {
    for _moss_li_d in "$MOSS_STATE_DIR"/*/; do
        [ -f "$_moss_li_d/manifest" ] || continue
        moss_manifest_read "$_moss_li_d/manifest"
        [ -n "$MOSS_M_NAME" ] && printf '%s\n' "$MOSS_M_NAME"
    done
}

# Comando principal 'list': imprime la tabla o JSON de todos los instalados.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_STATE_DIR, MOSS_JSON, MOSS_PREFIX
# Retorna:
#   0 siempre
moss_cmd_list() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    moss_state_init || exit $MOSS_EX_DEP

    _moss_ls_idx=0
    if moss_index_load >/dev/null 2>&1; then
        _moss_ls_idx=1
    fi

    if [ "$MOSS_JSON" -eq 1 ]; then
        printf '{"installed":['
        _moss_ls_first=1
        for _moss_ls_d in "$MOSS_STATE_DIR"/*/; do
            [ -d "$_moss_ls_d" ] || continue
            [ -f "$_moss_ls_d/manifest" ] || continue
            moss_manifest_read "$_moss_ls_d/manifest"
            [ "$_moss_ls_first" -eq 0 ] && printf ','
            _moss_ls_first=0
            _moss_ls_avail=''
            if [ "$_moss_ls_idx" -eq 1 ] && moss_index_lookup "$MOSS_M_NAME" 2>/dev/null; then
                _moss_ls_avail=$(printf ',"available_version":"%s"' "$(moss_jesc "$MOSS_L_VERSION")")
            fi
            printf '{"name":"%s","version":"%s","installed_at":"%s","prefix":"%s"%s}' \
                "$(moss_jesc "$MOSS_M_NAME")" "$(moss_jesc "$MOSS_M_VERSION")" \
                "$(moss_jesc "$MOSS_M_DATE")" "$(moss_jesc "$MOSS_M_PREFIX")" "$_moss_ls_avail"
        done
        printf ']}\n'
        exit $MOSS_EX_OK
    fi

    printf "%-20s %-25s %-15s %s\n" "ID PAQUETE" "BINARIO" "VERSION" "ACTUALIZADO"

    _moss_desk_base="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    [ "$MOSS_SYSTEM" -eq 1 ] && _moss_desk_base="/usr/share/applications"

    _moss_ls_any=0
    for _moss_ls_d in "$MOSS_STATE_DIR"/*/; do
        [ -d "$_moss_ls_d" ] || continue
        [ -f "$_moss_ls_d/manifest" ] || continue
        _moss_ls_any=1
        
        _moss_ls_id=$(basename "$_moss_ls_d")
        
        _moss_ls_ver=$(awk -F= '$1=="version"{print $2; exit}' "$_moss_ls_d/manifest")
        [ -z "$_moss_ls_ver" ] && _moss_ls_ver="desconocida"

        _moss_ls_name=""
        
        if [ -d "$MOSS_PREFIX/bin" ]; then
            for _moss_ls_bin in "$MOSS_PREFIX/bin"/*; do
                [ -h "$_moss_ls_bin" ] || continue
                if readlink "$_moss_ls_bin" | grep -Fq "/$_moss_ls_id/"; then
                    _moss_ls_name=$(basename "$_moss_ls_bin")
                    break
                fi
            done
        fi
        
        if [ -z "$_moss_ls_name" ]; then
            _moss_desk_file="$_moss_desk_base/moss-$_moss_ls_id.desktop"
            if [ -f "$_moss_desk_file" ]; then
                _moss_ls_name=$(awk -F= '$1=="Name"{print $2; exit}' "$_moss_desk_file")
            fi
        fi
        
        [ -z "$_moss_ls_name" ] && _moss_ls_name="$_moss_ls_id"

        _moss_ls_date=$(date -r "$_moss_ls_d" -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null)
        if [ -z "$_moss_ls_date" ]; then
            _moss_ls_date=$(stat -c "%y" "$_moss_ls_d" 2>/dev/null | awk '{print $1"T"$2"Z"}' | awk -F. '{print $1"Z"}')
            [ -z "$_moss_ls_date" ] && _moss_ls_date="desconocida"
        fi

        printf "%-20.20s %-25.25s %-15.15s %s\n" "$_moss_ls_id" "$_moss_ls_name" "$_moss_ls_ver" "$_moss_ls_date"
    done
    
    [ "$_moss_ls_any" -eq 1 ] || moss_log INFO "Ningun paquete instalado."
    exit $MOSS_EX_OK
}

# Comando principal 'search': busca y filtra paquetes remotos disponibles.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_JSON
# Retorna:
#   0 siempre
moss_cmd_search() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP
    moss_index_load || exit $?
    _moss_s_pat=$1

    if [ "$MOSS_JSON" -eq 1 ]; then
        printf '{"results":['
        _moss_s_first=1
        awk -F "$MOSS_TAB" -v p="$_moss_s_pat" '
            BEGIN { pl = tolower(p) }
            $1 ~ /^#/ || NF < 4 { next }
            {
                line = tolower($0)
                if (index(line, pl) > 0) {
                    d = $5; gsub(/"/, "\\\"", d)
                    printf "%s{\"name\":\"%s\",\"version\":\"%s\",\"description\":\"%s\"}",
                        (f++ ? "," : ""), $1, $2, d
                }
            }' "$_moss_index_file"
        printf ']}\n'
        exit $MOSS_EX_OK
    fi

    if ! awk -F "$MOSS_TAB" -v p="$_moss_s_pat" '
        BEGIN { pl = tolower(p); found = 0 }
        $1 ~ /^#/ || NF < 4 { next }
        {
            line = tolower($0)
            if (index(line, pl) > 0) {
                printf "%-24s %-14s %s\n", $1, $2, $5
                found = 1
            }
        }
        END { if (!found) exit 1 }
    ' "$_moss_index_file"; then
        moss_log WARN "No se encontraron paquetes que coincidan con '$_moss_s_pat'"
    fi
    exit $MOSS_EX_OK
}

# Comando principal 'info': reporta la situacion remota y el estado local.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_STATE_DIR, MOSS_JSON
# Retorna:
#   0 siempre
moss_cmd_info() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP
    _moss_in_name=$1

    _moss_in_inst=0
    if moss_manifest_read "$MOSS_STATE_DIR/$_moss_in_name/manifest"; then
        _moss_in_inst=1
    fi
    _moss_in_idx=0
    if moss_index_load && moss_index_lookup "$_moss_in_name"; then
        _moss_in_idx=1
    fi
    if [ "$_moss_in_inst" -eq 0 ] && [ "$_moss_in_idx" -eq 0 ]; then
        moss_die $MOSS_EX_USAGE "paquete desconocido: $_moss_in_name"
    fi

    if [ "$MOSS_JSON" -eq 1 ]; then
        printf '{"name":"%s","installed":%s' "$(moss_jesc "$_moss_in_name")" \
            "$([ "$_moss_in_inst" -eq 1 ] && printf true || printf false)"
        if [ "$_moss_in_inst" -eq 1 ]; then
            printf ',"installed_version":"%s","installed_at":"%s","prefix":"%s"' \
                "$(moss_jesc "$MOSS_M_VERSION")" "$(moss_jesc "$MOSS_M_DATE")" \
                "$(moss_jesc "$MOSS_M_PREFIX")"
        fi
        if [ "$_moss_in_idx" -eq 1 ]; then
            printf ',"available_version":"%s","url":"%s","sha256":"%s","description":"%s"' \
                "$(moss_jesc "$MOSS_L_VERSION")" "$(moss_jesc "$MOSS_L_URL")" \
                "$(moss_jesc "$MOSS_L_SHA")" "$(moss_jesc "$MOSS_L_DESC")"
        fi
        printf '}\n'
        exit $MOSS_EX_OK
    fi

    if [ "$_moss_in_idx" -eq 1 ]; then
        printf 'nombre:       %s\n' "$_moss_in_name"
        printf 'version:      %s\n' "$MOSS_L_VERSION"
        printf 'url:          %s\n' "$MOSS_L_URL"
        printf 'sha256:       %s\n' "$MOSS_L_SHA"
        printf 'descripcion:  %s\n' "$MOSS_L_DESC"
    fi
    if [ "$_moss_in_inst" -eq 1 ]; then
        printf 'instalado:    %s (%s)\n' "$MOSS_M_VERSION" "$MOSS_M_DATE"
        printf 'prefijo:      %s\n' "$MOSS_M_PREFIX"
        printf 'checksum:     %s\n' "$MOSS_M_SHA"
    else
        printf 'instalado:    no\n'
    fi
    exit $MOSS_EX_OK
}

# Comando principal 'verify': verifica checksums de tarballs locales en cache.
#
# Argumentos:
#   $@ - Argumentos del usuario CLI
# Globales:
#   MOSS_STATE_DIR, MOSS_CACHE_DIR
# Retorna:
#   0 siempre
moss_cmd_verify() {
    moss_normargs "$@"
    _moss_an_saveifs=$IFS
    IFS='
'
    set -f
    set -- $MOSS_NORMED
    set +f
    IFS=$_moss_an_saveifs
    OPTIND=1
    while getopts ':hqjv' _moss_opt; do
        case $_moss_opt in
            h) moss_usage; return 0 ;;
            q) MOSS_LOG_LEVEL=1 ;;
            v) MOSS_LOG_LEVEL=3 ;;
            j) MOSS_JSON=1 ;;
            *) moss_die $MOSS_EX_USAGE "opcion invalida: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] || { moss_usage >&2; exit $MOSS_EX_USAGE; }
    moss_state_init || exit $MOSS_EX_DEP
    _moss_v_name=$1
    _moss_v_state=$MOSS_STATE_DIR/$_moss_v_name

    moss_manifest_read "$_moss_v_state/manifest" ||
        moss_die $MOSS_EX_USAGE "no esta instalado: $_moss_v_name"

    _moss_v_cache=$MOSS_CACHE_DIR/$MOSS_M_TARBALL
    if [ -f "$_moss_v_cache" ]; then
        _moss_v_src=$_moss_v_cache
    else
        _moss_v_src=$MOSS_TMPDIR/verify.$$
        moss_download "$MOSS_M_URL" "$_moss_v_src" ||
            moss_die $MOSS_EX_DOWNLOAD "no se pudo obtener el tarball de $MOSS_M_URL"
    fi

    if [ -n "$MOSS_M_SHA" ]; then
        _moss_v_got=$(moss_sha256 "$_moss_v_src" 2>/dev/null || printf '')
        [ "$_moss_v_got" = "$MOSS_M_SHA" ] ||
            moss_die $MOSS_EX_VERIFY "checksum del tarball no coincide"
    fi

    if [ -f "$_moss_v_state/files" ]; then
        while IFS= read -r _moss_v_f; do
            [ -e "$MOSS_M_PREFIX/$_moss_v_f" ] ||
                moss_die $MOSS_EX_VERIFY "falta archivo instalado: $MOSS_M_PREFIX/$_moss_v_f"
        done < "$_moss_v_state/files"
    fi

    if [ "$MOSS_JSON" -eq 1 ]; then
        printf '{"name":"%s","version":"%s","ok":true}\n' \
            "$(moss_jesc "$MOSS_M_NAME")" "$(moss_jesc "$MOSS_M_VERSION")"
    else
        moss_log INFO "verificacion correcta: $_moss_v_name $MOSS_M_VERSION"
    fi
    exit $MOSS_EX_OK
}

MOSS_NORMED=''

# Normaliza los argumentos dividiendo combinaciones cortas en opciones discretas.
#
# Argumentos:
#   $@ - Array crudo
# Globales:
#   MOSS_NORMED
# Retorna:
#   0 siempre
moss_normargs() {
    MOSS_NORMED=''
    for _moss_na_arg do
        case $_moss_na_arg in
            --dry-run)  _moss_na_arg=-n ;;
            --force)    _moss_na_arg=-f ;;
            --all)      _moss_na_arg=-a ;;
            --quiet)    _moss_na_arg=-q ;;
            --verbose)  _moss_na_arg=-v ;;
            --json)     _moss_na_arg=-j ;;
            --system)   _moss_na_arg=-s ;;
            --yes)      _moss_na_arg=-y ;;
            --exec)     _moss_na_arg=-e ;;
            --terminal) _moss_na_arg=-t ;;
            --help)     _moss_na_arg=-h ;;
        esac
        if [ -z "$MOSS_NORMED" ]; then
            MOSS_NORMED=$_moss_na_arg
        else
            MOSS_NORMED="$MOSS_NORMED
$_moss_na_arg"
        fi
    done
}

# Imprime de forma tabular y limpia la informacion y menu de ayuda de uso global.
#
# Argumentos:
#   Ninguno
# Globales:
#   PROG_NAME, MOSS_VERSION
# Retorna:
#   0, via stdout
moss_usage() {
    cat <<EOF
$PROG_NAME $MOSS_VERSION — Gestor de tarballs

USO:
  $PROG_NAME [opciones] <comando> [argumentos]

COMANDOS PRINCIPALES:
  install <nombre|URL|tar> Instala desde índice remoto, URL o archivo local
  remove <nombre|bin>      Desinstala un paquete del sistema
  update                   Sincroniza repositorios y detecta actualizaciones
  upgrade                  Instala las actualizaciones de paquetes disponibles
  update <nombre> <tar>    Actualiza un paquete usando un tarball local
CONSULTA Y MANTENIMIENTO:
  list                     Lista los paquetes instalados y sus versiones
  search <patron>          Busca paquetes en el índice remoto por nombre/desc
  info <nombre>            Muestra información de índice + estado local
  verify <nombre>          Verifica el checksum (sha256) de los archivos locales
  rollback <nombre>        Revierte un paquete a su versión instalada anterior


OPCIONES GLOBALES:
  -s, --system             Instala a nivel sistema (/usr/local, /var/lib/moss)
  -e, --exec <bin>         Fuerza el nombre del ejecutable a enlazar (solo install)
  -t, --terminal           Marca el archivo .desktop para abrirse en terminal (solo install)
  -n, --dry-run            Simula la instalación sin modificar el sistema
      --offline            Usa el caché del índice aunque esté vencido
  -q, --quiet              Silencia la salida, mostrando solo errores
  -v, --verbose            Aumenta el nivel de detalle en los logs
  -f, --force              Sobrescribe conflictos o reinstala si ya existe
  -j, --json               Formatea la salida en JSON (list, search, info, update)
      --index <URL>        Usa un índice personalizado (file:// o https://)
  -h, --help               Muestra este menú de ayuda
  -V, --version            Imprime la versión actual

ENTORNO Y RUTAS:
  MOSS_INDEX_URL           Fuente del índice remoto (~/.config/moss/config)
  MOSS_CACHE_DIR           Ruta del caché (por defecto: ~/.cache/moss/)
EOF
}

# Bucle principal del CLI: inicializa el entorno, parsea opciones y delega al subcomando.
#
# Argumentos:
#   $@ - Todo argumento pasado a bin/moss
# Globales:
#   Multiples variables globales configuradas a partir del entorno
# Retorna:
#   Despacha exit code del subcomando llamado
moss_main() {
    _moss_env_prefix=$MOSS_PREFIX
    _moss_env_state=$MOSS_STATE_DIR
    _moss_env_cache=$MOSS_CACHE_DIR
    _moss_env_index=$MOSS_INDEX_URL
    _moss_env_ttl=$MOSS_INDEX_TTL
    moss_load_config
    [ -n "$_moss_env_prefix" ] && MOSS_PREFIX=$_moss_env_prefix
    [ -n "$_moss_env_state" ] && MOSS_STATE_DIR=$_moss_env_state
    [ -n "$_moss_env_cache" ] && MOSS_CACHE_DIR=$_moss_env_cache
    [ -n "$_moss_env_index" ] && MOSS_INDEX_URL=$_moss_env_index
    [ -n "$_moss_env_ttl" ] && MOSS_INDEX_TTL=$_moss_env_ttl

    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)    moss_usage; exit 0 ;;
            -V|--version) printf '%s %s\n' "$PROG_NAME" "$MOSS_VERSION"; exit 0 ;;
            -q|--quiet)   MOSS_LOG_LEVEL=1; shift ;;
            -v|--verbose) MOSS_LOG_LEVEL=3; shift ;;
            -j|--json)    MOSS_JSON=1; shift ;;
            -s|--system)  MOSS_SYSTEM=1; shift ;;
            -n|--dry-run) MOSS_DRY_RUN=1; shift ;;
            -f|--force)   MOSS_FORCE=1; shift ;;
            --offline)    MOSS_OFFLINE=1; shift ;;
            --index)
                [ $# -ge 2 ] || moss_die $MOSS_EX_USAGE "--index requiere un valor"
                MOSS_INDEX_URL=$2
                shift 2
                ;;
            --index=*) MOSS_INDEX_URL=${1#--index=}; shift ;;
            --) shift; break ;;
            -*) moss_log ERROR "opcion desconocida: $1"; moss_usage >&2
                exit $MOSS_EX_USAGE ;;
            *)  break ;;
        esac
    done

    _moss_sub=${1:-help}
    [ $# -gt 0 ] && shift

    MOSS_TMPDIR=$(moss_mktempdir) || moss_die $MOSS_EX_DEP "no se pudo crear un directorio temporal"
    trap moss_cleanup 0
    trap 'exit 129' 1
    trap 'exit 130' 2
    trap 'exit 143' 15

    case $_moss_sub in
        install|add)         moss_cmd_install "$@" ;;
        remove|rm|uninstall) moss_cmd_remove "$@" ;;
        update)              moss_cmd_update "$@" ;;
        upgrade)             moss_cmd_upgrade "$@" ;;
        list|ls)             moss_cmd_list "$@" ;;
        search|find)         moss_cmd_search "$@" ;;
        info|show)           moss_cmd_info "$@" ;;
        verify|check)        moss_cmd_verify "$@" ;;
        rollback)            moss_cmd_rollback "$@" ;;

        help)                moss_usage; exit 0 ;;
        *)
            moss_log ERROR "subcomando desconocido: $_moss_sub"
            moss_usage >&2
            exit $MOSS_EX_USAGE
            ;;
    esac
}

moss_main "$@"
exit $?
